# ----------------------------------------------------------------------------
# Sudan Digital Record System - Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# IMPORTANT: Never commit your real ".env" file. Only the anon (public) key is
# used by the client. Never expose the service_role key in the frontend.
# ----------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://hrtqjksjwimmqwfvgrdg.supabase.co

# Your Supabase anon/public API key
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhydHFqa3Nqd2ltbXF3ZnZncmRnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI0ODI2NzYsImV4cCI6MjA5ODA1ODY3Nn0.q7U5hU5XN0nCmG7A3_etqE3xxVNcdswKs67v74Qep7k

# Name of the Supabase Storage bucket used for record photos.
# Defaults to "record-photos" if not set (must match the bucket created in Supabase).
VITE_SUPABASE_PHOTO_BUCKET=record-photos
